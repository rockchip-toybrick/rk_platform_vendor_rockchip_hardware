soong_config_module_type {
    name: "camera_rockchip_soong_gen_defaults",
    module_type: "cc_defaults",
    config_namespace: "camera_rockchip",
    bool_variables: [
        "virtual",
    ],
    properties: ["cflags"],
}
camera_rockchip_soong_gen_defaults {
    name: "camera_virtual_rockchip_gen_defaults",
    soong_config_variables: {
        virtual: {
            cflags: ["-DVIRTUAL_ENABLE"],
        },

   }
}

cc_library_shared {
    name: "rockchip.hardware.hdmi@1.0-impl",
    defaults: ["camera_virtual_rockchip_gen_defaults"],
    relative_install_path: "hw",
    proprietary: true,
    srcs: [
        "Hdmi.cpp",
        "HdmiCallback.cpp",
        "DeviceV4L2Event.cpp",
    ],
    shared_libs: [
        "libhidlbase",
        "libcutils",
        "libutils",
        "liblog",
        "librga",
        "libui",
        "rockchip.hardware.hdmi@1.0",
        "android.hardware.graphics.mapper@4.0",
    ],
    include_dirs: [
        "hardware/rockchip/librga",
    ],
    header_libs: [
        "libhardware_rockchip_headers",
    ],
}

cc_binary {
    name: "rockchip.hardware.hdmi@1.0-service",
    init_rc: ["rockchip.hardware.hdmi@1.0-service.rc"],
    vintf_fragments: ["rockchip.hardware.hdmi@1.0-service.xml"],
    defaults: ["hidl_defaults"],
    proprietary: true,
    relative_install_path: "hw",
        srcs: ["service.cpp",
    ],
    cflags: ["-Werror", "-Wno-unused-parameter"],
    shared_libs: [
        "liblog",
        "libhardware",
        "libhidlbase",
        "libutils",
        "libcutils",
        "rockchip.hardware.hdmi@1.0",
        "libbinder",
        "libhidlmemory",
    ],
}
